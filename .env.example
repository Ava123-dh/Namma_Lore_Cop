# Copy to .env and fill in keys
# For Google Gemini (Generative Language API) - FREE TIER AVAILABLE
# Get a free API key at: https://ai.google.dev/tutorials/python_quickstart
# Replace the placeholder below with your key in a local `.env` file (do NOT commit keys).
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# For Anthropic Claude (Optional - PAID)
# Only needed if you want to use Claude instead of Gemini
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Server port (optional)
PORT=4000

# For Google Cloud Text-to-Speech (walk narration HD voices)
# Needs a Google CLOUD API key with the "Cloud Text-to-Speech API" enabled
# (this is a different API from the Gemini/Generative Language key above).
# If unset, the app falls back to GOOGLE_API_KEY, then to the browser voice.
GOOGLE_TTS_API_KEY=YOUR_GOOGLE_CLOUD_TTS_API_KEY_HERE
